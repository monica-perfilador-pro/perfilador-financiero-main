"""
Tests de calibracion v3.0 — presion financiera y estabilidad.

Incluye el caso real reportado por Monica:
  edad=56, nomina, tarjeta_alta+baja, hipotecario=infonavit,
  utilizacion ~65%, 3 productos activos, plazo 72 meses.
  Motor v2: PRE APROBADO DIRECTO
  Financiera real: RECHAZADO por presion y politicas
  Motor v3 esperado: SE_VA_A_ANALISIS con condicionamientos correctos
"""
import sys
import os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import pytest
from core import analizar, InputsAnalisis


def make_input(**kwargs) -> InputsAnalisis:
    defaults: dict = dict(
        nombre="Test", telefono="5555555555", correo="t@t.com",
        edad=35, ingreso=30000.0, tipo_ingreso="Nomina",
        negocio_casa=0, antiguedad_dom=3, domicilio_id=1,
        precio=300000.0, enganche=60000.0, plazo=60,
        consultas=0, auto_previo=2, credinissan=2, hipotecario=3,
        tarjeta_alta=2, tarjeta_baja=2, atrasos_mop=1,
        enganche_disp=1, compra_mes=1, unidad_disp=1,
        # v3 defaults
        utilizacion_revolvente=0,
        productos_activos=0,
        consultas_recientes=0,
        nivel_deuda_actual=0,
    )
    defaults.update(kwargs)
    return InputsAnalisis(
        nombre=str(defaults["nombre"]),
        telefono=str(defaults["telefono"]),
        correo=str(defaults["correo"]),
        edad=int(defaults["edad"]),
        ingreso=float(defaults["ingreso"]),
        tipo_ingreso=str(defaults["tipo_ingreso"]),
        negocio_casa=int(defaults["negocio_casa"]),
        antiguedad_dom=int(defaults["antiguedad_dom"]),
        domicilio_id=int(defaults["domicilio_id"]),
        precio=float(defaults["precio"]),
        enganche=float(defaults["enganche"]),
        plazo=int(defaults["plazo"]),
        consultas=int(defaults["consultas"]),
        auto_previo=int(defaults["auto_previo"]),
        credinissan=int(defaults["credinissan"]),
        hipotecario=int(defaults["hipotecario"]),
        tarjeta_alta=int(defaults["tarjeta_alta"]),
        tarjeta_baja=int(defaults["tarjeta_baja"]),
        atrasos_mop=int(defaults["atrasos_mop"]),
        enganche_disp=int(defaults["enganche_disp"]),
        compra_mes=int(defaults["compra_mes"]),
        unidad_disp=int(defaults["unidad_disp"]),
        utilizacion_revolvente=int(defaults["utilizacion_revolvente"]),
        productos_activos=int(defaults["productos_activos"]),
        consultas_recientes=int(defaults["consultas_recientes"]),
        nivel_deuda_actual=int(defaults["nivel_deuda_actual"]),
    )


# ════════════════════════════════════════════════════════════════
# CASO REAL — 56 años nómina, utilización alta, plazo 72
# ════════════════════════════════════════════════════════════════
class TestCasoRealReportado:

    def caso_real(self):
        return make_input(
            edad=56,
            ingreso=40000,
            tipo_ingreso="Nomina",
            negocio_casa=2,
            antiguedad_dom=3,
            domicilio_id=1,
            precio=290000,
            enganche=85000,
            plazo=72,
            consultas=3,
            auto_previo=2,
            credinissan=2,
            hipotecario=2,       # infonavit
            tarjeta_alta=1,
            tarjeta_baja=1,
            atrasos_mop=1,
            # v3: presion y estabilidad
            utilizacion_revolvente=65,   # BBVA 73% + Banamex 44% ~promedio
            productos_activos=3,         # hipoteca + 2 tarjetas
            consultas_recientes=3,
            nivel_deuda_actual=2,        # media
        )

    def test_no_es_directo_ni_automatico(self):
        """Motor v3 no debe dar DIRECTO ni AUTOMATICO a este perfil."""
        r = analizar(self.caso_real())
        assert r.plan not in ("AUTOMATICO", "DIRECTO"), (
            f"Caso real no debe ser AUTOMATICO/DIRECTO. Plan: {r.plan}"
        )

    def test_va_a_analisis_o_condicionado(self):
        """Debe ir a analisis manual o plan condicionado."""
        r = analizar(self.caso_real())
        planes_esperados = {
            "SE_VA_A_ANALISIS",
            "CONDICIONADO",
            "CONDICIONADO_MOP2",
            "RESCATE",
        }
        assert r.plan in planes_esperados, (
            f"Plan esperado: {planes_esperados}, obtenido: {r.plan}"
        )

    def test_detecta_presion_financiera(self):
        """Debe haber disparado regla de presion."""
        r = analizar(self.caso_real())
        reglas_presion = {
            "PR1_ALTA", "PR1_CRITICA", "PR2_MEDIO", "PR2_ELEVADO",
            "PR3_MEDIA", "PR3_ALTA", "PR4_MEDIA", "PR4_ALTA",
            "PR_BLOQUEA_AUTO", "POST_PRESION", "POST_PRESION_MEDIA",
        }
        disparadas = set(r.reglas_disparadas)
        tiene_presion = bool(reglas_presion & disparadas)
        assert tiene_presion, (
            f"Debe detectar presion financiera. "
            f"Disparadas: {r.reglas_disparadas}"
        )

    def test_detecta_riesgo_edad_plazo(self):
        """56 años + 72 meses = 62 al terminar. Debe detectar zona de atencion."""
        r = analizar(self.caso_real())
        # 56 + 6 = 62 años al terminar: ATENCION
        reglas_estabilidad = {"EST1_ATENCION", "EST1_ALTO", "EST1_CRITICO"}
        disparadas = set(r.reglas_disparadas)
        tiene_edad = bool(reglas_estabilidad & disparadas)
        assert tiene_edad, (
            f"Debe detectar riesgo de edad+plazo (62 años al terminar). "
            f"Disparadas: {r.reglas_disparadas}"
        )

    def test_condicionamientos_no_vacios(self):
        """Debe generar condicionamientos especificos."""
        r = analizar(self.caso_real())
        assert len(r.condicionamientos) > 0, (
            "Debe haber condicionamientos para este perfil complejo"
        )

    def test_mensaje_asesor_es_informativo(self):
        """El mensaje debe dar contexto real al asesor."""
        r = analizar(self.caso_real())
        assert len(r.mensaje_asesor) > 30, (
            f"Mensaje muy corto: {r.mensaje_asesor}"
        )


