# ESTABILIDAD ESTRUCTURAL — casos especificos
# ════════════════════════════════════════════════════════════════
class TestEstabilidadEstructural:

    def test_60_anos_plazo_72_detecta_atencion(self):
        """60 años + 72 meses = 66. Debe detectar zona ALTO."""
        r = analizar(make_input(
            edad=60, plazo=72,
            ingreso=50000, enganche=90000, precio=300000,
        ))
        assert "EST1_ALTO" in r.reglas_disparadas or \
               "EST1_CRITICO" in r.reglas_disparadas, (
            f"60+6=66 años debe ser ALTO. Disparadas: {r.reglas_disparadas}"
        )

    def test_56_anos_plazo_72_detecta_atencion(self):
        """56 años + 72 meses = 62. Debe detectar ATENCION."""
        r = analizar(make_input(edad=56, plazo=72))
        assert "EST1_ATENCION" in r.reglas_disparadas, (
            f"56+6=62 debe ser ATENCION. Disparadas: {r.reglas_disparadas}"
        )

    def test_40_anos_plazo_60_ok(self):
        """40 años + 60 meses = 45. Debe ser OK."""
        r = analizar(make_input(edad=40, plazo=60))
        assert "EST1_OK" in r.reglas_disparadas, (
            f"40+5=45 debe ser OK. Disparadas: {r.reglas_disparadas}"
        )

    def test_65_anos_cualquier_plazo_bloquea(self):
        """65 años + 60 meses = 70. Debe bloquear AUTOMATICO."""
        r = analizar(make_input(
            edad=65, plazo=60,
            ingreso=80000,
            tarjeta_alta=1, credinissan=1, auto_previo=1, hipotecario=1,
        ))
        assert r.plan != "AUTOMATICO", (
            f"65+5=70 años debe bloquear AUTOMATICO. Plan: {r.plan}"
        )
        assert "EST1_CRITICO" in r.reglas_disparadas

    def test_plazo_maximo_recomendado_se_calcula(self):
        """Debe calcular plazo maximo correcto para perfil de edad."""
        from core.estabilidad import evaluar_estabilidad
        from core.trace import Trace

        # 56 años, plazo max para terminar en <65 = (65-56)*12 = 108
        # pero para terminar en <60 = (60-56)*12 = 48
        inputs = make_input(edad=56, plazo=72)
        trace = Trace()
        from core.estabilidad import evaluar_estabilidad
        est = evaluar_estabilidad(inputs, trace)

        assert est.edad_al_terminar == 62
        assert est.riesgo_edad_plazo == "ATENCION"
        # Plazo recomendado deberia ser menor al actual
        assert est.plazo_maximo_rec <= 72

    def test_cotitular_joven_sugerido_en_edad_critica(self):
        """Para edad critica debe sugerir cotitular mas joven."""
        r = analizar(make_input(
            edad=67, plazo=60,
            ingreso=80000,
            tarjeta_alta=1, credinissan=1,
        ))
        conds = " ".join(r.condicionamientos).upper()
        assert "COTITULAR" in conds or "PLAZO" in conds, (
            f"Edad critica debe sugerir cotitular o reducir plazo: {r.condicionamientos}"
        )


