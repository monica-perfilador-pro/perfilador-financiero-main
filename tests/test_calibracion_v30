# PRESION FINANCIERA — casos específicos
# ════════════════════════════════════════════════════════════════
class TestPresionFinanciera:

    def test_sin_tarjetas_no_presion_revolvente(self):
        """Sin tarjetas no debe haber presion revolvente."""
        r = analizar(make_input(
            tarjeta_alta=2, tarjeta_baja=2,
            utilizacion_revolvente=0,
        ))
        assert "PR1_CRITICA" not in r.reglas_disparadas
        assert "PR1_ALTA" not in r.reglas_disparadas

    def test_utilizacion_80_bloquea_automatico(self):
        """Utilizacion >80% debe bloquear AUTOMATICO."""
        r = analizar(make_input(
            ingreso=80000,
            tarjeta_alta=1,
            credinissan=1,
            auto_previo=1,
            utilizacion_revolvente=85,  # critica
            productos_activos=2,
        ))
        assert r.plan != "AUTOMATICO", (
            f"Utilizacion 85% debe bloquear AUTOMATICO. Plan: {r.plan}"
        )
        assert "PR1_CRITICA" in r.reglas_disparadas

    def test_utilizacion_baja_no_penaliza(self):
        """Utilizacion baja no debe penalizar perfil bueno."""
        r = analizar(make_input(
            ingreso=80000,
            tarjeta_alta=1,
            credinissan=1,
            auto_previo=1,
            hipotecario=1,
            utilizacion_revolvente=20,  # baja
            productos_activos=2,
        ))
        # Perfil fuerte con baja utilizacion puede ser automatico
        assert r.plan in {"AUTOMATICO", "SE_VA_A_ANALISIS"}

    def test_muchos_productos_activos_bloquea(self):
        """4+ productos activos debe bloquear AUTOMATICO."""
        r = analizar(make_input(
            ingreso=80000,
            tarjeta_alta=1,
            credinissan=1,
            productos_activos=4,
        ))
        assert r.plan != "AUTOMATICO", (
            f"4 productos activos debe bloquear AUTOMATICO. Plan: {r.plan}"
        )
        assert "PR2_ELEVADO" in r.reglas_disparadas

    def test_presion_baja_no_afecta_aprobacion(self):
        """Presion baja no debe cambiar decision de perfil bueno."""
        r = analizar(make_input(
            ingreso=80000,
            tarjeta_alta=1,
            credinissan=1,
            auto_previo=1,
            hipotecario=1,
            utilizacion_revolvente=15,
            productos_activos=1,
            nivel_deuda_actual=0,
        ))
        # Sin presion, perfil fuerte debe ser aprobado
        assert r.plan in {"AUTOMATICO", "SE_VA_A_ANALISIS"}


