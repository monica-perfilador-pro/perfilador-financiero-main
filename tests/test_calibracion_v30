# RETROCOMPATIBILIDAD — defaults no rompen casos v2
# ════════════════════════════════════════════════════════════════
class TestRetrocompatibilidadV2:

    def test_sin_variables_v3_funciona_igual(self):
        """Sin las nuevas variables, el motor debe seguir funcionando."""
        # Caso de aprobacion limpia (sin variables v3)
        r = analizar(make_input(
            ingreso=80000,
            tarjeta_alta=1,
            credinissan=1,
            auto_previo=1,
            hipotecario=1,
            # NO se pasan utilizacion_revolvente, productos_activos, etc.
            # Usan defaults (0)
        ))
        assert r.version_motor == "3.0.0"
        assert r.probabilidad > 0
        assert r.plan is not None

    def test_defaults_no_penalizan_perfil_bueno(self):
        """Los defaults (0) no deben penalizar un perfil bueno."""
        r = analizar(make_input(
            ingreso=80000,
            tarjeta_alta=1,
            credinissan=1,
            auto_previo=1,
            hipotecario=1,
            enganche=90000,
            precio=300000,
            plazo=48,  # plazo corto, 35+4=39 años
            edad=35,
            # variables v3 en 0 (sin dato)
            utilizacion_revolvente=0,
            productos_activos=0,
            consultas_recientes=0,
            nivel_deuda_actual=0,
        ))
        # Con defaults en 0 y buen perfil, no debe penalizar
        assert r.plan in {"AUTOMATICO", "SE_VA_A_ANALISIS"}

    def test_determinismo_con_nuevas_variables(self):
        """Mismo input v3 = mismo output siempre."""
        inputs = make_input(
            utilizacion_revolvente=65,
            productos_activos=3,
            consultas_recientes=3,
            nivel_deuda_actual=2,
        )
        resultados = [analizar(inputs) for _ in range(5)]
        primero = resultados[0]
        for r in resultados[1:]:
            assert r.plan == primero.plan
            assert r.probabilidad == primero.probabilidad


